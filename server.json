{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.GillMacedo/stuckgo",
  "description": "Find what a stuck Go program is waiting on from a goroutine dump, with no connection to it.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/GillMacedo/stuckgo",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "stuckgo",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [],
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
